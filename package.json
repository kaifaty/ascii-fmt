{
  "name": "ascii-fmt",
  "version": "0.1.0",
  "description": "CLI tool to fix and align ASCII diagrams generated by AI agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kaifaty/ascii-fmt.git"
  },
  "keywords": [
    "ascii",
    "diagram",
    "formatter",
    "cli",
    "box-drawing",
    "rust",
    "text-processing"
  ],
  "author": "ascii-fmt contributors",
  "scripts": {
    "build": "node scripts/build.js",
    "postinstall": "node scripts/build.js",
    "clean": "rimraf target bin",
    "prebuild": "rimraf target/release",
    "test": "cargo test",
    "lint": "cargo clippy -- -D warnings",
    "fmt": "cargo fmt",
    "fmt:check": "cargo fmt --check",
    "bench": "cargo bench"
  },
  "bin": {
    "ascii-fmt": "./bin/ascii-fmt",
    "ascii-fmt-opencode-setup": "./scripts/opencode-setup.js"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64",
    "ia32"
  ],
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.5"
  },
  "files": [
    "bin",
    "scripts"
  ],
  "bugs": {
    "url": "https://github.com/kaifaty/ascii-fmt/issues"
  },
  "homepage": "https://github.com/kaifaty/ascii-fmt#readme"
}
